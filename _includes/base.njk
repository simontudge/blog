<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if lead %}<meta name="description" content="{{ lead | striptags | truncate(155) }}">{% endif %}

    <link rel="stylesheet" href="/site.css">

    {# The site answers on www and on workers.dev as well; this names the one
       canonical address so crawlers don't treat them as separate copies.
       Cloudflare redirects the .html form to the extensionless one, and the
       index pages link that way too, so the canonical drops .html to match. #}
    <link rel="canonical" href="{{ site.url }}{{ page.url | replace('.html', '') }}">

    <title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — Simon's Blog{% else %}Simon's Blog{% endif %}</title>
  </head>
  <body>

    <nav class="masthead">
      <a href="/">Simon's Blog</a>
      {% if crumb %}<span>/</span> <a href="{{ crumbHref }}">{{ crumb }}</a>{% endif %}
    </nav>

    {{ content | safe }}

  </body>
</html>
