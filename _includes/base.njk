<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Posts carry either a lead or a blurb, and occasionally neither, so fall
       through them in order rather than letting the description go missing. #}
    {%- set summary = description or lead or blurb %}
    {# Cloudflare redirects the .html form to the extensionless one, and the
       index pages link that way too, so URLs here drop .html to match. #}
    {%- set canonical = site.url + (page.url | replace('.html', '')) %}
    {%- set shareImage = site.url + (thumbnail or site.image) %}

    {% if summary %}<meta name="description" content="{{ summary | striptags | truncate(155) }}">{% endif %}

    <link rel="stylesheet" href="/site.css">

    {# The site answers on www and on workers.dev as well; this names the one
       canonical address so crawlers don't treat them as separate copies. #}
    <link rel="canonical" href="{{ canonical }}">

    <title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — Simon's Blog{% else %}Simon's Blog{% endif %}</title>

    {# Shared links otherwise render as a bare URL with no title or picture. #}
    <meta property="og:site_name" content="{{ site.name }}">
    {# Posts carry a crumb; the section listings carry a collection as well. #}
    <meta property="og:type" content="{% if crumb and not collection %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
    <meta property="og:url" content="{{ canonical }}">
    {% if summary %}<meta property="og:description" content="{{ summary | striptags | truncate(155) }}">{% endif %}
    <meta property="og:image" content="{{ shareImage }}">
    <meta name="twitter:card" content="summary_large_image">
  </head>
  <body>

    <nav class="masthead">
      <a href="/">Simon's Blog</a>
      {% if crumb %}<span>/</span> <a href="{{ crumbHref }}">{{ crumb }}</a>{% endif %}
    </nav>

    {{ content | safe }}

  </body>
</html>
